# Use a NEW Discord application and a NEW database dedicated to this bot.
DISCORD_TOKEN=YOUR_NEW_BOT_TOKEN
DISCORD_CLIENT_ID=YOUR_NEW_APPLICATION_ID
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/NEW_BOURSE_DATABASE
# Comma-separated Discord guild IDs, or exactly * for a public bot. Empty is fail-closed.
BOURSE_GUILD_IDS=YOUR_GUILD_ID
# Stable shared namespace. Required explicitly in public mode (use the app ID).
# Finite mode defaults to the first configured guild ID. Keep stable when moving hosts.
ECONOMY_SCOPE_ID=
# Optional comma-separated channels or category IDs; empty allows every channel.
BOURSE_CHANNEL_IDS=
PREFIX=!
# Optional starting CC per NEW member, granted once on their first saved trade.
INITIAL_CC=0
# Optional one-time trader role setup (false by default).
TRADER_ROLE_ENABLED=false
# Daily media streak in the original CHAOS streak room.
STREAK_ENABLED=false
# Casino (/casino mines|coinflip|slots|dice|roulette|rocket; crash is the rocket): optional comma-separated channel or category IDs.
# Empty uses the same channels as the rest of the bot (BOURSE_CHANNEL_IDS). The games menu (/games, العاب) also
# answers there. Game rules and timings are CASINO in src/config/casino.js (no environment variable).
CASINO_CHANNEL_IDS=
# Most CC one casino bet can take (whole number, 10 to 1000000000). Default 50000.
# Leave empty for no cap (a bet is only limited by the balance); set a number to cap it.
CASINO_MAX_BET=
# Optional custom emojis for the casino messages, as one JSON object keyed by meaning, for example
# {"slots.cherry":"<:cherry:123456789012345678>","mines.safe":"<a:gem:123456789012345678>"}. Every key and its
# default is in src/config/emojis.js. A custom emoji must live in a server the bot is in. Leave empty to use Unicode.
CASINO_EMOJIS=
# Optional per-guild role anchors: guildId:roleId,guildId:roleId.
# Leave empty to create below the bot's highest role without a leveling dependency.
TRADER_ROLE_ANCHORS=
LOG_LEVEL=info
# StreakBot application's user ID. Its "تم تحديث الستريك" posts pay CC in server 1472405236000751778
# (that server must also be in BOURSE_GUILD_IDS). Required: empty = no streak payouts.
STREAKBOT_ID=
# Owners (comma-separated Discord user IDs) who may use addcc. Edit this to change who is an owner.
OWNER_IDS=1159601661392715906

# Chat games (src/games/, typed as `.اوامر`, `!توب`...): optional comma-separated channel or category IDs where the
# general games commands (اوامر, توب, نقاط, convert) answer, besides the bot's channels. Empty = BOURSE_CHANNEL_IDS.
# Knobs: src/config/games.js.
GAMES_CHANNEL_IDS=
# Trusted members start any game in any channel: owners, Manage Server, a role in EVENT_ROLE_IDS, TRUSTED_USER_IDS
# or a role in TRUSTED_ROLE_IDS (all comma-separated Discord IDs).
EVENT_ROLE_IDS=
TRUSTED_USER_IDS=
TRUSTED_ROLE_IDS=
# Channel or category IDs where ANY member may start games (comma-separated). Empty = 1570728118182744145.
OPEN_GAMES_CHANNEL_IDS=

# Games bot (Clover) application IDs whose win messages pay CC (comma separated). Empty = Clover 1006332825571692544.
# Copy the value from the old bot if Clover runs under another ID. 2000 CC a group win (no limit), 500 an answer win
# (at most 20000 CC per member per UTC day from answers and points conversions together).
GAMES_BOT_IDS=

# Invite gift: 5000 CC (CC.inviteReward in src/config/cc.js) to the inviter when the member they invited reaches
# level 5, read from the level bot's announcement in its level-up room, and wrote 50 chat messages in that server
# (either order; accounts younger than 7 days and rejoins never count). Needs Manage Server in that server (to read
# the invites) and the Server Members Intent switched on in the developer portal (to see members join).
# Level bot user ID(s), comma separated. Empty = 1513858357142880346.
LEVEL_BOT_IDS=
# Level-up room(s), comma separated. Empty = 1571798045580984360. Invites are tracked (and messages counted) in these
# rooms' servers.
LEVEL_CHANNEL_IDS=
# Off unless true (no invite tracking, no message counting, no GuildInvites intent). Nothing is posted when a member
# joins: Aether (DISbot) tells who invited them and the gift; keep its CC_INVITE_GIFT_ENABLED and CC_LEVEL_CHANNEL_IDS
# equal to INVITE_REWARD_ENABLED and LEVEL_CHANNEL_IDS here.
INVITE_REWARD_ENABLED=

# This bot's own welcome line: `welcome to <server name> @member 👋`, never anything about the invite. Off unless
# true: Aether (DISbot) sends the welcome, so leave it off where Aether is.
# Needs the Server Members Intent switched on in the developer portal.
WELCOME_ENABLED=
# guildId:channelId pairs, comma separated, on top of the defaults (CHAOS 1155236281706627173:1547305745417113700,
# Zenith 1569932761471524874:1570728122259611779); guildId:off = no welcome there. A server without one uses its
# system messages channel, else a text channel named welcome.
WELCOME_CHANNEL_IDS=
