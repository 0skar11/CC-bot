# Use a NEW Discord application and a NEW database dedicated to this bot.
DISCORD_TOKEN=YOUR_NEW_BOT_TOKEN
DISCORD_CLIENT_ID=YOUR_NEW_APPLICATION_ID
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/NEW_BOURSE_DATABASE
# Comma-separated Discord guild IDs, or exactly * for a public bot. Empty is fail-closed.
BOURSE_GUILD_IDS=YOUR_GUILD_ID
# Stable shared namespace. Required explicitly in public mode (use the app ID).
# Finite mode defaults to the first configured guild ID. Keep stable when moving hosts.
ECONOMY_SCOPE_ID=
# Optional comma-separated channels or category IDs; empty allows every channel.
BOURSE_CHANNEL_IDS=
PREFIX=!
# Optional starting CC per NEW member, granted once on their first saved trade.
INITIAL_CC=0
# Optional one-time trader role setup (false by default).
TRADER_ROLE_ENABLED=false
# Daily media streak in the original CHAOS streak room.
STREAK_ENABLED=false
# Casino (/casino mines|coinflip|slots): optional comma-separated channel or category IDs.
# Empty uses the same channels as the rest of the bot (BOURSE_CHANNEL_IDS).
CASINO_CHANNEL_IDS=
# Most CC one casino bet can take (whole number, 10 to 1000000000). Default 50000.
CASINO_MAX_BET=50000
# Optional per-guild role anchors: guildId:roleId,guildId:roleId.
# Leave empty to create below the bot's highest role without a leveling dependency.
TRADER_ROLE_ANCHORS=
LOG_LEVEL=info
# Owners (comma-separated Discord user IDs) who may use addcc. Edit this to change who is an owner.
OWNER_IDS=1159601661392715906
